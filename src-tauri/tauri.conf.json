  "productName": "rempaint",
  "version": "0.2.0",
  "identifier": "com.flashwebby.rempaint",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "rempaint",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
